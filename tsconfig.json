{
    "compilerOptions": {
        "target": "ES2021",
        "lib": ["ES2021", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "strict": true,
        "allowJs": true,
        "isolatedModules": true,
        "incremental": true, // ✅ manter — cacheia compilações
        "tsBuildInfoFile": ".next/cache/tsconfig.tsbuildinfo", // ✅ NOVO: cache no .next
        "jsx": "preserve",
        "skipLibCheck": true, // ✅ manter — não recompila @types
        "noEmit": true, // ✅ CORRIGIR: Next não precisa emitir arquivos
        "types": ["node", "react", "react-dom"],
        "baseUrl": ".",
        "ignoreDeprecations": "6.0", // ✅ silencia o aviso do baseUrl
        "paths": {
            "@/*": ["./src/*"]
        },
        "plugins": [{ "name": "next" }]
    },
    "include": [
        "next-env.d.ts",
        "server.ts",
        "src/**/*",
        ".next/types/**/*.ts"
        // ❌ REMOVI scripts/**/* — se não usar, o tsserver analisa desnecessariamente
    ],
    "exclude": ["node_modules", ".next", "dist"]
}
